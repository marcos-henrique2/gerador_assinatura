# Copie este arquivo para .env e preencha os valores.
# Para gerar SECRET_KEY e ADMIN_PASSWORD_HASH automaticamente,
# rode: configurar_admin.bat

# Chave usada para assinar a sessão (string aleatória longa)
SECRET_KEY=

# Hash da senha do painel admin (gerado pelo configurar_admin.bat)
ADMIN_PASSWORD_HASH=

# Debug do Flask (mantenha 0 em produção)
FLASK_DEBUG=0
